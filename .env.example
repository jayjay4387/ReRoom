# ReRoom environment variables.
# Copy this file to `.env` at the repo root and fill in real values.
# The backend loads it via dotenv (backend/src/index.ts -> ../.env).
# NEVER commit the real .env (it is gitignored).

# --- Google Gemini (image generation: gemini-3.1-flash-image-preview) ---
GEMINI_API_KEY=

# --- eachlabs.ai (Kling 3.0 video) ---
EACHLABS_API_KEY=

# --- Cloudinary (file storage: frames + video) ---
# Dashboard: cloudinary.com -> Dashboard shows all three.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- MongoDB Atlas (gallery metadata) ---
# Atlas -> Connect -> Drivers. DB + collection are created automatically.
MONGODB_URI=
# Optional: database name (defaults to "reroom" if unset).
MONGODB_DB=
